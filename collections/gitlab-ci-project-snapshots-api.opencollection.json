{
  "opencollection": "1.0.0",
  "info": {
    "name": "GitLab access_requests project_snapshots API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "project_snapshots",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download a (possibly inconsistent) snapshot of a repository",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/projects/:id/snapshot",
            "params": [
              {
                "name": "wiki",
                "value": "",
                "type": "query",
                "description": "Set to true to receive the wiki repository"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This feature was introduced in GitLab 10.7"
        }
      ]
    }
  ],
  "bundled": true
}