            "method": "PUT",
            "url": "{{baseUrl}}/api/v4/groups/:id/invitations/:email",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The group ID"
              },
              {
                "name": "email",
                "value": "",
                "type": "path",
                "description": "The email address of the invitation"
              }
            ]
          },
          "docs": "Updates a group or project invitation."
        },
        {
