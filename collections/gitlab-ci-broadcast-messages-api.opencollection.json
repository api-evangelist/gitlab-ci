                "description": "Broadcast message ID"
              }
            ]
          },
          "docs": "This feature was introduced in GitLab 8.12."
        },
        {
          "info": {
            "name": "Delete a broadcast message",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v4/broadcast_messages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
