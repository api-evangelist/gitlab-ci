      },
      "items": [
        {
          "info": {
            "name": "List group clusters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/groups/:id/clusters",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the group"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Current page number"
              },
              {
                "name": "per_page",
                "value": "20",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "This feature was introduced in GitLab 12.1. Returns a list of group clusters."
        },
        {
          "info": {
            "name": "Get a single group cluster",
            "type": "http"
          },
