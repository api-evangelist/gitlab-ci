{
  "opencollection": "1.0.0",
  "info": {
    "name": "GitLab access_requests submodules API",
    "version": "v4"
  },
  "items": [
    {
      "info": {
        "name": "submodules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "putApiV4ProjectsIdRepositorySubmodulesSubmodule",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v4/projects/:id/repository/submodules/:submodule",
            "params": [
              {
                "name": "id",
                "value": "gitlab-org/gitlab",
                "type": "path",
                "description": "The ID or URL-encoded path of a project"
              },
              {
                "name": "submodule",
                "value": "gitlab-org/gitlab-shell",
                "type": "path",
                "description": "URL-encoded full path to submodule."
              }
            ]
          },
          "docs": "Update existing submodule reference in repository"
        }
      ]
    }
  ],
  "bundled": true
}