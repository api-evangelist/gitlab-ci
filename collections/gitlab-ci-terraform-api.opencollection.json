          "info": {
            "name": "Download the latest version of a module",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/projects/:id/packages/terraform/modules/:module_name/:module_system",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID or full path of a project"
              },
              {
                "name": "module_name",
                "value": "infra-registry",
                "type": "path",
                "description": "Module name"
              },
              {
                "name": "module_system",
                "value": "aws",
                "type": "path",
                "description": "Module system"
              },
              {
                "name": "terraform-get",
                "value": "",
                "type": "query",
                "description": "Terraform get redirection flag"
              }
            ]
          },
          "docs": "This feature was introduced in GitLab 16.7"
